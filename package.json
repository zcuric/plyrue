{
  "name": "plyrue",
  "version": "3.0.0",
  "description": "Vue 3 component/plugin for plyr.js.",
  "keywords": [
    "vue",
    "vue3",
    "plyr",
    "player",
    "video",
    "audio",
    "youtube",
    "vimeo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcuric/plyrue.git"
  },
  "homepage": "https://github.com/zcuric/plyrue#readme",
  "bugs": {
    "url": "https://github.com/zcuric/plyrue/issues"
  },
  "license": "MIT",
  "author": "Zdravko Ćurić <zcuric@gmail.com>",
  "type": "module",
  "main": "./dist/plyrue.umd.cjs",
  "module": "./dist/plyrue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/plyrue.js",
      "require": "./dist/plyrue.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --config example/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build",
    "build:example": "vite build --config example/vite.config.ts"
  },
  "peerDependencies": {
    "plyr": "^3.7.8",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.53.1",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/language-core": "^3.3.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "plyr": "^3.8.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
